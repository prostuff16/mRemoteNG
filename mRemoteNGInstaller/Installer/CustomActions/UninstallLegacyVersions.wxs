<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?include $(sys.CURRENTDIR)Includes\Config.wxi?>
	<Fragment>
    <!-- firstSequence: these are scheduled in both the UI and execute sequences, but only need to run once. Re-running
         them inside the installer service can fail (SFXCA "Failed to create temp directory. Error code 5") on locked-down machines -->
    <CustomAction Id="CheckIfLegacyVersionInstalled" Return="check" Execute="firstSequence" BinaryKey="CustomActions.CA.dll" DllEntry="IsLegacyVersionInstalled" />
	</Fragment>
  <Fragment>
    <CustomAction Id="UninstallLegacyVersion" Return="check" Execute="firstSequence" BinaryKey="CustomActions.CA.dll" DllEntry="UninstallLegacyVersion" />
  </Fragment>
</Wix>